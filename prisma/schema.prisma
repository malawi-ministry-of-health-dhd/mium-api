datasource db {
  provider = "mysql" // or mysql/sqlite
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String

  // Relations
  roles    UserRole[]
  programs UserProgram[]
}

model Role {
  id    Int     @id @default(autoincrement())
  name  String  @unique

  users UserRole[]
}

model Program {
  id    Int     @id @default(autoincrement())
  name  String  @unique

  users UserProgram[]
}

// Join table for User ↔ Role
model UserRole {
  userId Int
  roleId Int

  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// Join table for User ↔ Program
model UserProgram {
  userId    Int
  programId Int

  user      User    @relation(fields: [userId], references: [id])
  program   Program @relation(fields: [programId], references: [id])

  @@id([userId, programId])
}
